# Django REST API base endpoint for the CyberShield backend.
VITE_API_URL="http://127.0.0.1:8000/api/"

# Data source switch (development only):
#   VITE_USE_MOCK_DATA=true  -> DEMO MODE, uses temporary data in src/data/
#   VITE_USE_MOCK_DATA=false -> REAL API MODE, calls the Django backend and
#                               reports real API errors (no demo fallback).
VITE_USE_MOCK_DATA="true"
