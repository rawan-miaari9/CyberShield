# CyberShield backend environment template.
# Copy to .env and fill in real values. Never commit .env.

# Database connection string parsed by dj-database-url.
# Local dev example format: sqlite:///db.sqlite3
# Managed Postgres example format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Django secret key (long random string, production must differ from dev).
SECRET_KEY=

# Base URL of the separately running OWASP ZAP instance (server-side only).
ZAP_BASE_URL=

# OWASP ZAP API key (server-side only, never exposed to the frontend).
ZAP_API_KEY=

# Google Gemini API key for the AI Security Assistant (server-side only).
GEMINI_API_KEY=
